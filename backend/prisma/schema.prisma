generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovieStatus {
  WANT_TO_WATCH
  WATCHED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  createdAt    DateTime @default(now())
  movieEntries MovieEntry[]
}

model MovieEntry {
  id         Int         @id @default(autoincrement())
  userId     Int
  movieId    Int
  title      String
  posterPath String?
  status     MovieStatus
  rating     Float?
  comment    String?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])
}

